APP_URL=http://localhost:3000
SESSION_SECRET=change-me-to-a-random-32-char-string
PORT=3000
DATA_DIR=./data

# Email provider: resend | smtp | console (auto-detected if omitted)
# EMAIL_PROVIDER=smtp

# Resend (cloud)
# RESEND_API_KEY=re_xxx

# SMTP (self-hosted — works with any SMTP server, relay, or service)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=OpenLetter <noreply@example.com>

# Or set a shared from address for any provider
# EMAIL_FROM=OpenLetter <noreply@open-letter.uk>
